# =============================================
# Ayura AI — Environment Variables
# Copy this file to .env and fill in your values.
# The server reads both server/.env and the root .env.
# =============================================

# --- App ---
# In production (APP_ENV=production) startup will FAIL unless all of the following
# are set to non-default/secure values: SECRET_KEY, JWT_SECRET_KEY, ADMIN_TOKEN,
# DEBUG=false, TRUSTED_HOSTS, REDIS_URL (when rate limiting is on), SMS_OTP_MOCK=false.
APP_NAME=Ayura AI
APP_ENV=development          # development | production
DEBUG=true                   # MUST be false in production (leaks error internals otherwise)
SECRET_KEY=change-me-in-production
ADMIN_TOKEN=change-this-admin-token
PLAN_TIMEOUT_SECONDS=120
# CACHE_ENABLED=true

# --- MongoDB ---
# Either set MONGO_URL directly, or set the individual parts below.
# MONGO_URL=mongodb://user:password@host:27017/ayura?authSource=admin
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=ayura
# MONGO_USER and MONGO_PASSWORD are required by docker-compose.yml (used to
# bootstrap the mongo container's root credentials and to build the api MONGO_URL).
# MONGO_USER=ayura
# MONGO_PASSWORD=

# --- Redis (required in production for the background worker and rate limiting) ---
REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD is consumed by docker-compose.yml to password-protect the redis
# container (and is embedded into the REDIS_URL the api/worker use).
# REDIS_PASSWORD=

# --- ChromaDB ---
# Leave CHROMA_HOST unset to use embedded local storage (dev default).
# CHROMA_HOST=localhost
CHROMA_PORT=8001
# CHROMA_PERSIST_DIRECTORY=server/data/chromadb  # default

# --- LLM: Azure OpenAI (primary) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- LLM: Google Gemini (fallback — app works with only this set) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- LangSmith tracing (optional — observability for the LangGraph health agent) ---
# Leave LANGSMITH_API_KEY blank to disable tracing entirely (zero overhead).
# Set it (get a key at https://smith.langchain.com) to trace every agent run,
# tool call, and token in the LangSmith dashboard.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ayura-health-agent
LANGSMITH_TRACING=true

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback  # derived from FRONTEND_URL if unset

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- JWT ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# COOKIE_SECURE=false    # auto-forced true in production
# COOKIE_SAMESITE=lax    # auto-forced strict in production

# --- Weather (optional — OpenWeatherMap free tier) ---
# WEATHER_API_KEY=

# --- Sentry Error Tracking ---
# Strongly recommended in production: without a DSN the integration is inert and
# server/worker/browser errors are reported nowhere. Backend and frontend take
# separate DSNs (one project each). Get them at sentry.io → Project → Client Keys.
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# --- Product Analytics (PostHog) ---
# Project API key from PostHog → Settings → Project. Baked at build time, so the
# web image must be rebuilt after changing it (not just restarted).
# Use the EU host for India/EU users; switch to https://us.i.posthog.com if the
# project was created in the US region — a mismatched host silently drops events.
# Unset = analytics disabled, no SDK fetched. See client/src/lib/analytics.js for
# the privacy contract (autocapture and session recording are OFF by design).
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- File Uploads ---
# Local uploads directory is used when S3 vars are unset.
# UPLOADS_DIR=server/uploads
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_REGION_NAME=
# S3_ENDPOINT_URL=    # for R2 / Spaces / MinIO

# --- Email / SMTP (for verification & password reset) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@ayura.com

# --- SMS / OTP ---
SMS_OTP_MOCK=true          # set false in production with Twilio configured
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# FRONTEND_URLS=https://yourdomain.com,https://www.yourdomain.com   # comma-separated extra origins
# TRUSTED_HOSTS=yourdomain.com,www.yourdomain.com

# --- Rate Limiting (per-minute burst) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
# Number of proxies WE control in front of the app. The client IP is read this
# many entries from the right of X-Forwarded-For, so entries a caller prepends
# themselves are ignored. 1 = our own nginx. Raise to 2 if you put a CDN/LB in
# front — and make that nginx APPEND (`$proxy_add_x_forwarded_for`) again.
TRUSTED_PROXY_HOPS=1

# --- Per-user daily quotas (sustained LLM cost ceiling) ---
# Rate limits cap bursts; these cap the bill. Every plan generation and chat
# turn is a paid Azure/Gemini call. Counted per user per UTC day; admins exempt.
QUOTA_ENABLED=true
DAILY_PLAN_QUOTA=40
DAILY_CHAT_QUOTA=200

# --- Login lockout (per account, not per IP) ---
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# =============================================
# Frontend (Vite) — prefix with VITE_
# These are read by client/vite.config.js from the root .env.
# =============================================
# VITE_API_URL=/api    # defaults to /api (proxied by Vite dev server)
